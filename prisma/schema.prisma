// This file is the single source of truth for the database structure.
// Field names match the CLIENT-CONFIRMED report (BAJO_MART_MONTHLY_ANNUAL.xlsx).
// After changing anything here, run: npm run db:migrate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─────────────────────────────────────────────
// Who can log in (Owner, Partner)
// ─────────────────────────────────────────────
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  dailyEntries DailyEntry[]
  auditLogs    AuditLog[]
  resetTokens  PasswordResetToken[]

  @@map("users")
}

// ─────────────────────────────────────────────
// The reusable vendor/expense master list
// ─────────────────────────────────────────────
enum VendorGroup {
  OPERATING
  WHOLESALE
  SNACKS_BEVERAGE
}

model Vendor {
  id        String      @id @default(uuid())
  name      String
  group     VendorGroup
  isActive  Boolean     @default(true) @map("is_active")
  sortOrder Int         @default(0) @map("sort_order")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  expenses DailyExpense[]

  @@map("vendors")
}

// ─────────────────────────────────────────────
// One row per calendar day (header/summary data)
// Field names match the CLIENT-CONFIRMED report exactly.
// ─────────────────────────────────────────────
model DailyEntry {
  id        String   @id @default(uuid())
  entryDate DateTime @unique @map("entry_date") @db.Date // plain DATE, no time/timezone

  mopSale Decimal @default(0) @map("mop_sale") @db.Decimal(12, 2)
  eft     Decimal @default(0) @db.Decimal(12, 2)

  // Gas: Sale & Purchase section (day-level totals)
  gasSale    Decimal @default(0) @map("gas_sale") @db.Decimal(12, 2)
  gasInvoice Decimal @default(0) @map("gas_invoice") @db.Decimal(12, 2)
  posFee     Decimal @default(0) @map("pos_fee") @db.Decimal(12, 2)
  creCarFee  Decimal @default(0) @map("cre_car_fee") @db.Decimal(12, 2)
  totalCard  Decimal @default(0) @map("total_card") @db.Decimal(12, 2) // server-calculated
  stBalDiff  Decimal @default(0) @map("st_bal_diff") @db.Decimal(12, 2)

  // Lotto section
  lottoTotal          Decimal @default(0) @map("lotto_total") @db.Decimal(12, 2)
  lottoTicketSold     Decimal @default(0) @map("lotto_ticket_sold") @db.Decimal(12, 2)
  lottoCashActivation Decimal @default(0) @map("lotto_cash_activation") @db.Decimal(12, 2)
  lottoCommission     Decimal @default(0) @map("lotto_commission") @db.Decimal(12, 2)
  lottoRent           Decimal @default(0) @map("lotto_rent") @db.Decimal(12, 2)

  // Payment section
  payCreditCard Decimal @default(0) @map("pay_credit_card") @db.Decimal(12, 2)
  payDebitCard  Decimal @default(0) @map("pay_debit_card") @db.Decimal(12, 2)
  payMobil      Decimal @default(0) @map("pay_mobil") @db.Decimal(12, 2)
  payEbtCash    Decimal @default(0) @map("pay_ebt_cash") @db.Decimal(12, 2)
  payCashInHand Decimal @default(0) @map("pay_cash_in_hand") @db.Decimal(12, 2)
  payFs         Decimal @default(0) @map("pay_fs") @db.Decimal(12, 2)

  // Store section
  storeSale       Decimal @default(0) @map("store_sale") @db.Decimal(12, 2)
  storeTax        Decimal @default(0) @map("store_tax") @db.Decimal(12, 2)
  storeCigTaxPaid Decimal @default(0) @map("store_cig_tax_paid") @db.Decimal(12, 2)
  storeCDeposit   Decimal @default(0) @map("store_c_deposit") @db.Decimal(12, 2)
  storeEDeposit   Decimal @default(0) @map("store_e_deposit") @db.Decimal(12, 2)
  storeTDeposit   Decimal @default(0) @map("store_t_deposit") @db.Decimal(12, 2)

  // Final totals — server-calculated only. Confirmed simple formulas:
  //   Total Bank Expense = SUM of all vendor bank amounts that day
  //   Total Cash Expense = SUM of all vendor cash amounts that day
  //   Total Expense      = Total Bank Expense + Total Cash Expense
  totalBankExpense Decimal @default(0) @map("total_bank_expense") @db.Decimal(12, 2)
  totalCashExpense Decimal @default(0) @map("total_cash_expense") @db.Decimal(12, 2)
  totalExpense     Decimal @default(0) @map("total_expense") @db.Decimal(12, 2)

  createdById String   @map("created_by")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  fuelGallons GasGallons[]
  expenses    DailyExpense[]

  @@map("daily_entries")
}

// ─────────────────────────────────────────────
// Gallons per fuel type within a day
// ─────────────────────────────────────────────
enum FuelType {
  REGULAR
  PLUS
  PREMIUM
  DIESEL
}

model GasGallons {
  id           String     @id @default(uuid())
  dailyEntryId String     @map("daily_entry_id")
  dailyEntry   DailyEntry @relation(fields: [dailyEntryId], references: [id], onDelete: Cascade)

  fuelType FuelType @map("fuel_type")
  gallons  Decimal  @default(0) @db.Decimal(12, 3)

  @@unique([dailyEntryId, fuelType])
  @@map("gas_gallons")
}

// ─────────────────────────────────────────────
// Every vendor expense entry for a given day.
// A vendor can have BOTH a bank amount AND a cash amount on the same day.
// ─────────────────────────────────────────────
model DailyExpense {
  id           String     @id @default(uuid())
  dailyEntryId String     @map("daily_entry_id")
  dailyEntry   DailyEntry @relation(fields: [dailyEntryId], references: [id], onDelete: Cascade)

  vendorId String @map("vendor_id")
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  bankAmount Decimal @default(0) @map("bank_amount") @db.Decimal(12, 2)
  cashAmount Decimal @default(0) @map("cash_amount") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([dailyEntryId, vendorId])
  @@map("daily_expenses")
}

// ─────────────────────────────────────────────
// Audit trail for edits to past entries
// ─────────────────────────────────────────────
enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model AuditLog {
  id        String      @id @default(uuid())
  tableName String      @map("table_name")
  recordId  String      @map("record_id")
  action    AuditAction

  changedById String @map("changed_by")
  changedBy   User   @relation(fields: [changedById], references: [id])

  oldValues Json?    @map("old_values")
  newValues Json?    @map("new_values")
  changedAt DateTime @default(now()) @map("changed_at")

  @@map("audit_log")
}

// ─────────────────────────────────────────────
// Forgot Password — a time-limited, single-use token emailed to the user.
// The raw token is only ever emailed to the user; the database stores just
// a hash of it (same principle as passwords — Security Doc Section 3).
// ─────────────────────────────────────────────
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}
