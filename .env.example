# Copy this file to .env.local AND .env (Prisma CLI reads .env, the app reads .env.local)
# NEVER commit .env.local or .env — they hold real secrets.

DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# For migrations only — use Neon's DIRECT (non-pooled) connection string here.
DIRECT_DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Generate with: openssl rand -base64 32
# Windows alt: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="replace-with-generated-secret"

NEXTAUTH_URL="http://localhost:3000"

NODE_ENV="development"

# Resend — used to send "Forgot Password" reset emails.
# Get your key from resend.com -> API Keys, after creating a free account.
# Leave blank during local dev — reset links will print to your terminal instead.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"
