# Your Neon (or Supabase) Postgres connection string.
# Find it on your Neon project dashboard -> "Connection string".
DATABASE_URL="postgresql://neondb_owner:npg_Jk7uwajcpZy6@ep-ancient-waterfall-aikh1e1a-pooler.c-4.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"


# A random secret used to encrypt login sessions.
# Generate one by running this in your terminal: openssl rand -base64 32
NEXTAUTH_SECRET="lO9ObXT9g8+SBoL6nwhN4V5KKUYO7tfpT84gRLGLqnI="


# The URL your app runs at.
# Local development:
NEXTAUTH_URL="http://localhost:3000"
# In production (Vercel), set this to your real domain instead, e.g:
# NEXTAUTH_URL="https://bajomart-app.vercel.app"

# development | production
NODE_ENV="development"

# Resend — used to send "Forgot Password" reset emails.
# Get your key from resend.com -> API Keys, after creating a free account.
RESEND_API_KEY=""
# Must be a verified sender. On a brand-new free Resend account, use this
# default test sender until you verify your own domain:
RESEND_FROM_EMAIL="onboarding@resend.dev"
